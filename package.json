{
  "name": "InterState",
  "description": "An editor for creating interactive applications.",
  "version": "0.1.0",
  "author": "Stephen Oney (Carnegie Mellon)",
  "maintainers": [
    {
      "name": "Stephen Oney",
      "email": "soney@cs.cmu.edu",
      "web": "http://from.so/"
    }
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/soney/interstate/blob/master/LICENSE"
    }
  ],
  "private": true,
  "dependencies": {
    "ejs": "7.0.1",
    "express": "5.3.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "sass": "1.105.1",
    "terser": "5.51.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server.js",
    "dev": "node scripts/build.js && node server.js --dev",
    "test": "npm run build && node --test test/server.test.js && playwright test",
    "test:browser": "playwright test"
  }
}
